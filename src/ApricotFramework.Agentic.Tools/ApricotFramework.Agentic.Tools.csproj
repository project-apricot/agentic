<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Declare AI tools once and surface them anywhere: a tool carries its own name, prompt, JSON schemas and behaviour, generated from ordinary .NET types, with authorization left to the host. Transport-agnostic, so the same declaration serves an in-process agent loop and a remote protocol such as MCP.</Description>
    <PackageTags>ai;agent;agentic;tools;function-calling;llm;mcp;json-schema</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
  </ItemGroup>

</Project>
