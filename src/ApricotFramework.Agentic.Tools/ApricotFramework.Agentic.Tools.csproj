<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Composes the AI tools a host offers and runs them: a registry over however many sources, filters and validators the host registers, and an executor that opens a scope, builds the invocation context and invokes the tool inside it. A tool is a Microsoft.Extensions.AI AIFunction, so the same declaration serves an in-process agent loop and a remote protocol such as MCP. Knows nothing about ASP.NET Core, MCP or gRPC.</Description>
    <PackageTags>ai;agent;agentic;tools;function-calling;llm;mcp;json-schema;dependency-injection</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ApricotFramework.Agentic.Tools.Abstractions/ApricotFramework.Agentic.Tools.Abstractions.csproj" />
  </ItemGroup>

</Project>
