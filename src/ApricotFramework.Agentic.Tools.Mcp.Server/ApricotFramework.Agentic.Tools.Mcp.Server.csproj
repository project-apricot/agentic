<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ApricotFramework.Agentic.Tools.Mcp.Server</RootNamespace>
    <Description>Exposes this host's agent tools over the Model Context Protocol. Lists them per request through the same filters that gate the call, so a tool added by an upstream server or revoked for a caller is reflected without a restart. A tool is already a Microsoft.Extensions.AI AIFunction, so there is no adapter between the two models.</Description>
    <PackageTags>ai;agent;agentic;tools;mcp;model-context-protocol;function-calling</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ApricotFramework.Agentic.Tools/ApricotFramework.Agentic.Tools.csproj" />
  </ItemGroup>

</Project>
