<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ApricotFramework.Agentic.Tools</RootNamespace>
    <Description>The declaration half of ApricotFramework.Agentic.Tools: what an AI tool is, written beside the code that runs it. A tool is a Microsoft.Extensions.AI AIFunction carrying a name, the prompt a model selects on, JSON schemas generated from ordinary .NET types, and the behaviour a caller's policy depends on. Reference this from a library that declares tools; the host references the package that composes them.</Description>
    <PackageTags>ai;agent;agentic;tools;function-calling;llm;mcp;json-schema;abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
  </ItemGroup>

</Project>
