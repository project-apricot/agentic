<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ApricotFramework.Agentic.Tools.Mcp.Client</RootNamespace>
    <Description>Tools from upstream MCP servers, as ordinary ApricotFramework.Agentic tools. Lists them per caller rather than once at start-up, so a host can federate servers connected per person, and offers them under names of its own. An MCP client's tool is already a Microsoft.Extensions.AI AIFunction, so nothing wraps it and what is behind it stays reachable.</Description>
    <PackageTags>ai;agent;agentic;tools;mcp;model-context-protocol;function-calling</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="ModelContextProtocol.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ApricotFramework.Agentic.Tools/ApricotFramework.Agentic.Tools.csproj" />
  </ItemGroup>

</Project>
