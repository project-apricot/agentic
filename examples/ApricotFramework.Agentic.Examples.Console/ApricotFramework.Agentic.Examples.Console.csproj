<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>ApricotFramework.Agentic.Examples.Console</AssemblyName>
    <RootNamespace>ApricotFramework.Agentic.Examples.Console</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <!-- Deliberately nothing else. No ASP.NET Core, no MCP server, no gRPC: a host that only
         wants a registry over its own tools and a few upstream servers takes two packages. -->
    <ProjectReference Include="../../src/ApricotFramework.Agentic.Tools/ApricotFramework.Agentic.Tools.csproj" />
    <ProjectReference Include="../../src/ApricotFramework.Agentic.Tools.Mcp.Client/ApricotFramework.Agentic.Tools.Mcp.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
